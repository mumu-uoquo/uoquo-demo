<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    该文件为模板文件，实际项目中请调整配置
    根节点<configuration>包含的属性说明：
    scan       : 当此属性设置为true时，配置文件如果发生改变，将会被重新加载，默认值为true。
    scanPeriod : 设置监测配置文件是否有修改的时间间隔，如果没有给出时间单位，默认单位是毫秒，默认的时间间隔为1分钟。当scan为true时，此属性生效。
    debug      : 当此属性设置为true时，将打印出logback内部日志信息，实时查看logback运行状态。默认值为false。
-->
<configuration scan="false" scanPeriod="60 seconds" debug="false">
    <!-- 设置变量  -->
    <!--<property resource="system.properties" />-->
    <!-- 读取配置中心的属性 -->
    <springProperty scope="context" name="log.name"   source="app.log.name" />
    <springProperty scope="context" name="log.home"   source="app.log.home" />
    <!-- %d表示日期，%thread表示线程名，%-5level：级别从左显示5个字符宽度%msg：日志消息，%n是换行符 -->
    <property name="log.format" value="[%date{yyyy-MM-dd'T'HH:mm:ss.SSS}] [%contextName] [%X{requestId}] [%thread] [%-5level] %logger{96} [%line] - %msg%n" />

    <!-- 当多个应用输出到同一个文件时，可以使用 %contextName 来区分。默认为“default” -->
    <contextName>${log.name}</contextName>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${log.format}</pattern>
            <charset>UTF-8</charset> <!-- 此处设置字符集 -->
        </encoder>
    </appender>
    <!-- 系统日志 -->
    <appender name="ROOT_LOG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${log.home}/catalina.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${log.format}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <append>true</append>
        <prudent>true</prudent>
    </appender>
    <!-- 访问日志 -->
    <appender name="ACCESS_LOG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.home}/access-${log.name}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.home}/history/access-${log.name}.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>365</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${log.format}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        FileAppender：把日志添加到文件
        RollingFileAppender：滚动记录文件，先将日志记录到指定文件，当符合某个条件时，将日志记录到其他文件
    -->
    <!-- 按天分割日志 -->
    <appender name="APP_LOG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.home}/${log.name}.log</file>
        <!-- 滚动策略（后缀为gz、zip时，自动压缩） -->
        <!-- 每天一个文件，最多保留365天，总日志大小不超过20GB -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.home}/history/${log.name}.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>365</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <!-- 每天一个文件，最多保留30天，每个文件不超过5MB -->
        <!--<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.home}/history/${log.app.name}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <maxFileSize>5MB</maxFileSize>
        </rollingPolicy>-->
        <!-- 日志内容 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${log.format}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 只打印 WARN 日志
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
    　　　　 <onMismatch>DENY</onMismatch>
        </filter>
        -->
        <!-- 打印 非WARN 日志
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>DENY</onMatch>
    　　　　 <onMismatch>ACCEPT</onMismatch>
        </filter>
        -->
    </appender>

    <!-- 日志输出，
         level : 级别大小写无关，ALL < TRACE < DEBUG < INFO < WARN < ERROR < FATAL < OFF
         root  : 所有日志输出
         logger：可以指定某些包的日志单独输出，如果没有设置level和appender，则使用root的配置
         name  : 包名或完整类名
         additivity: 是否向上级传递（默认true）
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ROOT_LOG_FILE" />
    </root>
    <logger name="com.uoquo.web.interceptor.GlobalInterceptor" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ACCESS_LOG_FILE" />
    </logger>

    <logger name="com.uoquo" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="APP_LOG_FILE" />
    </logger>

    <!-- 开发时，在eclipse中可以直接看日志信息，详情：https://logback.qos.ch/beagle/index.html -->
    <consolePlugin />

</configuration>